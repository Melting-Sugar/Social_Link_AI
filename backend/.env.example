# Copy to .env and fill in. See docs/requirements/requirements-definition.md
# for the decisions behind each of these.

ENVIRONMENT=dev

# --- Database / broker (§5) ---
DATABASE_URL=postgresql+asyncpg://social_link:social_link@localhost:5432/social_link
REDIS_URL=redis://localhost:6379/0

# --- Auth (§5, §11.2) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# --- CORS / frontend origin (§5) ---
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
FRONTEND_BASE_URL=http://localhost:3000
# Leave unset in dev (host-only cookie works across localhost ports). In
# prod, set to the shared parent domain, e.g. .example.com, so the
# refresh-token cookie is visible to both the app./api. subdomains.
COOKIE_DOMAIN=

# --- Vendors ---
# API keys themselves live in .env.keys at the project root, NOT here —
# see .env.keys.example. This file only holds non-credential vendor config.
EMAIL_FROM_ADDRESS=noreply@example.com

# --- Providers ---
# STT_PROVIDER=amivoice is the default (確定事項25): AmiVoice ESAS bundles
# sentiment analysis into the speech-recognition call itself, so it covers
# both STT and prosody in one request. Azure remains implemented but
# inactive — switch back with STT_PROVIDER=azure if ever needed.
STT_PROVIDER=amivoice
# Only consulted when STT_PROVIDER=azure (confirmed unused otherwise —
# AmiVoice's bundled sentiment is used instead). Empath was tested and
# rejected (確定事項27); Imentiv/audEERING remain unverified.
PROSODY_PROVIDER=none
# ecapa_local is the confirmed pick (§12.3 確定事項23) — self/other voice
# matching doesn't work at all with "none" (voice enrollment fails outright,
# not just degrades). Requires `uv sync --extra speaker-id` first (PyTorch/
# SpeechBrain — kept optional so the base install stays light, §5).
SPEAKER_ID_PROVIDER=ecapa_local
PIPELINE_MODE=hybrid

# --- Audio handling (§11.5, §3.4) ---
TEMP_AUDIO_DIR=/tmp/social-link-audio
# 確定事項28: capped for MVP so a single AmiVoice request stays close to
# its observed ~1x-realtime latency. Was 1800 (30 min) before the PoC.
MAX_RECORDING_SECONDS=60
