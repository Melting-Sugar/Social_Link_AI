# Environment / secrets
.env
.env.*
!.env.example
# .env.keys (project root): the single canonical file for every
# third-party vendor API key — never commit the real one, only the
# template (see docs/requirements/requirements-definition.md).
!.env.keys.example

# Node / Next.js (frontend)
node_modules/
.next/
out/
.pnpm-store/

# Python / FastAPI (backend)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local audio scratch (raw audio must never persist per docs/legal/privacy-policy.md — belt-and-suspenders against accidental local dev writes)
*.wav
*.webm

# Claude Code local-only settings (personal tool-permission state, not shared project config)
.claude/settings.local.json

# OS / editor
.DS_Store
.vscode/
.idea/
