# Copy to .env.keys (project root) and fill in. This is the ONLY place
# third-party vendor API keys should live — never in backend/.env,
# frontend/.env.local, or anywhere else. See .env.keys for why.

# https://console.anthropic.com/settings/keys
# Powers: statement-check (B-1), conversation report/summary generation
ANTHROPIC_API_KEY=

# https://portal.azure.com — Azure AI Speech resource
# Powers: STT/diarization for the conversation-support analysis pipeline
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast

# https://resend.com/api-keys
# Powers: registration-complete / username-reminder / password-reset emails
RESEND_API_KEY=

# https://huggingface.co/settings/tokens — also requires accepting
# pyannote/embedding's terms at https://huggingface.co/pyannote/embedding
# Only needed if SPEAKER_ID_PROVIDER=pyannote_local (§12.3 PoC candidate;
# SpeechBrain's ecapa_local needs no token at all — see the PoC writeup).
HF_TOKEN=

# Prosody vendor key(s) — added here once the PoC (requirements §13
# next-steps #1) picks a vendor. None yet.
