# Copy to .env.keys (project root) and fill in. This is the ONLY place
# third-party vendor API keys should live — never in backend/.env,
# frontend/.env.local, or anywhere else. See .env.keys for why.

# https://console.anthropic.com/settings/keys
# Powers: statement-check (B-1), conversation report/summary generation
ANTHROPIC_API_KEY=

# https://acp.amivoice.com — AmiVoice Cloud Platform
# Powers: STT/diarization AND prosody (ESAS sentiment analysis) for the
# conversation-support analysis pipeline — one key covers both, since
# ESAS is only available bundled into AmiVoice's own recognition request
# (確定事項25). This is the active default (STT_PROVIDER=amivoice).
AMIVOICE_API_KEY=

# https://portal.azure.com — Azure AI Speech resource
# Alternative STT vendor, implemented but inactive (STT_PROVIDER=azure to
# switch back). Verified working (確定事項24) but superseded by AmiVoice
# once ESAS was adopted, since it doesn't need a second STT call.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast

# https://resend.com/api-keys
# Powers: registration-complete / username-reminder / password-reset emails
RESEND_API_KEY=

# https://huggingface.co/settings/tokens — also requires accepting
# pyannote/embedding's terms at https://huggingface.co/pyannote/embedding
# Only needed if SPEAKER_ID_PROVIDER=pyannote_local (§12.3 PoC candidate;
# SpeechBrain's ecapa_local needs no token at all — see the PoC writeup).
HF_TOKEN=

# Empath was tested and rejected (確定事項27 — no diarization, inconsistent
# accuracy). No key needed; EMPATH_API_KEY is not read anywhere.
